{
  "name": "sienes-rhc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "rm -rf .next/dev/types && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm e2e",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed-admin.ts",
    "fixtures": "tsx --tsconfig tsconfig.json scripts/make-fixtures.ts",
    "parse:real": "tsx --tsconfig tsconfig.json scripts/parse-real-exports.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.110",
    "@base-ui/react": "^1.9.0",
    "ai": "7.0.164",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "docx": "9.15.3",
    "drizzle-orm": "0.45.4",
    "jszip": "3.10.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pdf-lib": "1.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  }
}
